# TengriChecker Railway Configuration

[nixpacks]
nixpkgs = ["nodejs-20_x"]

[variables]
HONEY_POT_PORT = "3001"
HONEY_POT_DATA = "/data"
NODE_ENV = "production"
PORT = "3001"

[start]
# Run server with explicit node path to ensure it's found
command = "/usr/bin/node server.js"

[deploy]
healthCheckPath = "/api/health"
healthCheckInterval = 30
restartPolicyType = "ON_FAILURE"
restartPolicyMaxRetries = 10
