{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "npm install && npm run build"
  },
  "deploy": {
    "startCommand": "/usr/bin/node server.js",
    "healthCheckPath": "/api/health",
    "healthCheckInterval": 30,
    "env": {
      "NETWORK_PORT": "3001",
      "NETWORK_DATA": "/data",
      "NODE_ENV": "production",
      "PORT": "3001",
      "DATABASE_URL": "postgresql://postgres:{DATABASE_PASSWORD}@{DATABASE_HOST}:5432/tengrichecker",
      "POSTGRES_URL": "postgresql://postgres:{DATABASE_PASSWORD}@{DATABASE_HOST}:5432/tengrichecker",
      "S3_BUCKET_NAME": "tengrichecker-network-data",
      "S3_ENCRYPTION_KEY": "tengrichecker-network-2025-encryption-key-32-bytes",
      "S3_ENDPOINT": "https://s3.railway.app",
      "AWS_ACCESS_KEY_ID": "{AWS_ACCESS_KEY_ID}",
      "AWS_SECRET_ACCESS_KEY": "{AWS_SECRET_ACCESS_KEY}",
      "JWT_SECRET": "tengrichecker-network-jwt-secret-key-2025",
      "SIGNING_SECRET": "tengrichecker-network-signing-secret-2025"
    },
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "services": {
    "honey-pot": {
      "name": "surprising-abundance",
      "runtime": {
        "image": "node:20-alpine"
      },
      "plan": "free",
      "ports": [
        {
          "port": 3001,
          "handler": "http"
        }
      ]
    }
  },
  "infrastructure": {
    "commands": {
      "postdeploy": "/usr/local/bin/node server.js"
    }
  }
}
