---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Badge from "../components/Badge.astro";
import { ratings, ratingOrder } from "../lib/ratings";
import { cases, fmtDate } from "../lib/site";
const all = (await getCollection("checks")).sort((a,b) => b.data.reviewed.localeCompare(a.data.reviewed) || a.data.case.localeCompare(b.data.case) || a.data.order-b.data.order);
const catalogue = Object.entries(cases).map(([slug,c]) => ({slug,...c,items:all.filter(x=>x.data.case===slug)})).filter(c=>c.items.length);
const activeRatings = ratingOrder.filter(key=>all.some(x=>x.data.rating===key));
---
<Base title="The claim catalogue">
  <section class="catalogue-intro" aria-labelledby="catalogue-title">
    <div><p class="eyebrow"><span class="status-dot"></span> The claim catalogue</p><h1 id="catalogue-title">Big claims.<br /><em>Show the proof.</em></h1><p>Tengri makes the claims. We check the records. See where he is wrong, where he is right, and what he has not proved.</p></div>
    <div class="catalogue-totals"><div><strong>{all.length.toString().padStart(2,"0")}</strong><span>claims reviewed</span></div><div><strong>{catalogue.length.toString().padStart(2,"0")}</strong><span>{catalogue.length===1 ? "case in the catalogue" : "cases in the catalogue"}</span></div><a href="/about#method">How we review claims ↗</a></div>
  </section>
  <section id="cases" class="case-directory" aria-labelledby="cases-title">
    <div class="directory-heading"><div><p class="eyebrow">Start with a case</p><h2 id="cases-title">Browse by case</h2></div><span>{catalogue.length} {catalogue.length===1 ? "case" : "cases"}</span></div>
    <div class="case-cards">{catalogue.map((c,i)=><article class="case-card">
      <div class="case-card-art" aria-hidden="true"><div><span>CASE {String(i+1).padStart(3,"0")}</span><span>{c.subject}</span></div><strong>{c.items.length}</strong><p>claims.<br />One complete record.</p><span>REVIEWED {fmtDate(c.reviewed).toUpperCase()}</span></div>
      <div class="case-card-copy"><p class="eyebrow">{c.subject} · {c.items.length} claims reviewed</p><h3><a href={`/case/${c.slug}`}>{c.title}</a></h3><p>{c.summary}</p><div class="case-card-links"><a class="button primary" href={`/case/${c.slug}`}>Open the case <span aria-hidden="true">→</span></a><a class="text-link" href={`/case/${c.slug}#claims`}>View its claims ↗</a></div></div>
    </article>)}</div>
  </section>
  <section id="claims" class="claim-directory" aria-labelledby="claims-title">
    <div class="directory-heading"><div><p class="eyebrow">Claim by claim</p><h2 id="claims-title">Every claim we checked</h2></div><a href="/ratings">What the findings mean ↗</a></div>
    <p class="directory-description">Each claim opens its evidence section inside the case page. Missing source links are clearly marked.</p>
    <form class="catalogue-filters" id="catalogue-filters" role="search" aria-label="Search the claim catalogue">
      <label class="catalogue-search"><span>Search claims</span><input id="catalogue-query" type="search" placeholder="Search a claim, topic or keyword…" autocomplete="off" /></label>
      <label><span>Case</span><select id="case-filter"><option value="all">All cases</option>{catalogue.map(c=><option value={c.slug}>{c.title}</option>)}</select></label>
      <label><span>Finding</span><select id="rating-filter"><option value="all">All findings</option>{activeRatings.map(key=><option value={key}>{ratings[key].label}</option>)}</select></label>
      <button type="reset" class="reset-filters">Reset</button>
    </form>
    <div class="catalogue-result-line"><p id="catalogue-count" aria-live="polite">{all.length} of {all.length} claims</p><span>Newest checks first</span></div>
    <ul class="catalogue-claims" id="catalogue-claims">{all.map(x=><li data-case={x.data.case} data-rating={x.data.rating} data-search={`${x.data.title} ${x.data.claim} ${x.data.quote} ${x.data.summary} ${cases[x.data.case].title} ${cases[x.data.case].subject}`.toLowerCase()}>
      <div class="claim-index"><span>{cases[x.data.case].subject}</span><strong>{String(x.data.order).padStart(2,"0")}</strong></div>
      <div class="catalogue-claim-copy"><p class="eyebrow"><a href={`/case/${x.data.case}`}>{cases[x.data.case].title}</a></p><h3><a href={`/case/${x.data.case}#claim-${x.id}`}>{x.data.title}</a></h3><p>{x.data.summary}</p><div class="claim-entry-meta"><span>{x.data.followUp ? "Follow-up text · source link pending" : "Main post"}</span><span>Reviewed {fmtDate(x.data.reviewed)}</span></div></div>
      <div class="catalogue-claim-action"><Badge rating={x.data.rating} /><a href={`/case/${x.data.case}#claim-${x.id}`}>Read our answer →</a></div>
    </li>)}</ul>
    <div class="catalogue-empty" id="catalogue-empty" hidden><h3>No matching claims</h3><p>Try a broader search or reset the filters to see the full catalogue.</p><button type="button" id="clear-empty" class="button secondary">Reset filters</button></div>
    <noscript><p>All claims are listed above. Enable JavaScript to use search and filters.</p></noscript>
  </section>
  <section class="catalogue-method"><div><p class="eyebrow">The SCHIFFY team’s response</p><h2>False.<br />These wallets are not ours.</h2></div><div><p>A trade shows that a wallet bought or sold. It does not show who owns that wallet. Tengri is wrong to treat trading activity as proof of team control.</p><a class="text-link" href="/about">Who runs this site & how we check →</a></div></section>
  <script>
    const form = document.querySelector<HTMLFormElement>("#catalogue-filters")!;
    const query = document.querySelector<HTMLInputElement>("#catalogue-query")!;
    const caseFilter = document.querySelector<HTMLSelectElement>("#case-filter")!;
    const ratingFilter = document.querySelector<HTMLSelectElement>("#rating-filter")!;
    const entries = [...document.querySelectorAll<HTMLLIElement>("#catalogue-claims > li")];
    const count = document.getElementById("catalogue-count")!;
    const empty = document.getElementById("catalogue-empty")!;
    function apply() {
      const term = query.value.trim().toLowerCase();
      let shown = 0;
      for (const entry of entries) {
        const match = (!term || entry.dataset.search!.includes(term)) && (caseFilter.value === "all" || entry.dataset.case === caseFilter.value) && (ratingFilter.value === "all" || entry.dataset.rating === ratingFilter.value);
        entry.hidden = !match;
        if(match) shown++;
      }
      count.textContent = `${shown} of ${entries.length} claims`;
      empty.hidden = shown !== 0;
    }
    form.addEventListener("submit", event => event.preventDefault());
    form.addEventListener("input", apply);
    form.addEventListener("change", apply);
    form.addEventListener("reset", () => { query.value=""; caseFilter.value="all"; ratingFilter.value="all"; apply(); });
    document.getElementById("clear-empty")!.addEventListener("click", () => { form.reset(); query.focus(); });
  </script>
</Base>
