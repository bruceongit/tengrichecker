# TengriChecker Caddyfile
# Serves both static Astro site and Node.js Honey Pot API

{
    auto_https off
    log {
        format json
    }
}

:3000 {
    # Health check (must be first to catch /health)
    handle /health {
        reverse_proxy localhost:3000
    }

    # API routes - proxy to Node.js server
    handle /api/* {
        reverse_proxy localhost:3000
    }

    # Static files from Astro dist (before /api routes)
    handle {
        root * ./dist
        try_files {path} /index.html
        file_server
    }
}
