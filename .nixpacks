[variables]
NETWORK_PORT = "3001"
NETWORK_DATA = "/data"
NODE_ENV = "production"
PORT = "3001"

[start]
# Run server with node binary from Railway's node:20-alpine image at /usr/local/bin/node
command = "/usr/local/bin/node server.js"

[deploy]
healthCheckPath = "/api/health"
healthCheckInterval = 30
restartPolicyType = "ON_FAILURE"
restartPolicyMaxRetries = 10
