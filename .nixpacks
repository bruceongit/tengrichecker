[variables]
NETWORK_PORT = "3001"
NETWORK_DATA = "/data"
NODE_ENV = "production"
PORT = "3001"

[start]
# Run server with 'node' command (available in Railway's runtime PATH)
command = "node server.js"

[deploy]
healthCheckPath = "/api/health"
healthCheckInterval = 30
restartPolicyType = "ON_FAILURE"
restartPolicyMaxRetries = 10
