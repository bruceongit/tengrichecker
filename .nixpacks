# TengriChecker Railway Configuration

[nixpacks]
nixpkgs = ["nodejs-20_x"]
startCommand = "node server.js"

[variables]
HONEY_POT_PORT = "3001"
HONEY_POT_DATA = "/data"
NODE_ENV = "production"

[deploy]
startCommand = "node server.js"
healthCheckPath = "/health"
healthCheckInterval = 30
restartPolicyType = "ON_FAILURE"
restartPolicyMaxRetries = 10
