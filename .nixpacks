[variables]
NETWORK_PORT = "3001"
NETWORK_DATA = "/data"
NODE_ENV = "production"
PORT = "3001"

[start]
# Run server with node binary (uses NODE_PATH env var or falls back to 'node' in PATH)
command = "sh -c 'exec ${NODE_PATH:-node} server.js'"

[deploy]
healthCheckPath = "/api/health"
healthCheckInterval = 30
restartPolicyType = "ON_FAILURE"
restartPolicyMaxRetries = 10
