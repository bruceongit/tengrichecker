# TengriChecker Railway Configuration

[nixpacks]
nixpkgs = ["nodejs-20_x"]

[variables]
HONEY_POT_PORT = "3001"
HONEY_POT_DATA = "/data"
NODE_ENV = "production"
PORT = "3001"

[start]
# Run server with node20 (common alias in nixpkgs) or node
command = "node20 server.js || node server.js"

[deploy]
healthCheckPath = "/api/health"
healthCheckInterval = 30
restartPolicyType = "ON_FAILURE"
restartPolicyMaxRetries = 10
