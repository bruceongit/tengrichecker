# TengriChecker Railway Configuration

[nixpacks]
nixpkgs = ["nodejs-20_x"]

[variables]
NETWORK_PORT = "3001"
NETWORK_DATA = "/data"
NODE_ENV = "production"
PORT = "3001"

[start]
# Run server with fallback for different node binary locations
command = "sh -c 'exec node server.js || exec /usr/local/bin/node server.js || exec /usr/bin/node server.js'"

[deploy]
healthCheckPath = "/api/health"
healthCheckInterval = 30
restartPolicyType = "ON_FAILURE"
restartPolicyMaxRetries = 10
