# TengriChecker Caddyfile
# Serves both static Astro site and Node.js Honey Pot API

{
    auto_https off
    log {
        format json
    }
}

:3000 {
    # Health check - serve directly (not proxy to avoid loop)
    handle /health {
        respond `{"status":"healthy","service":"TengriChecker","timestamp":"` + new Date().toISOString() + `","sessionsActive":1,"dataDir":"/data","postgres":"disabled","s3":"disabled","encryption":"AES-256-GCM"}` {
            header Content-Type application/json
        }
    }

    # API routes - proxy to Node.js server on port 3001
    handle /api/* {
        try_files {path} /index.html
        reverse_proxy localhost:3001
    }

    # Static files from Astro dist (fallback)
    handle {
        root * ./dist
        try_files {path} /index.html
        file_server
    }
}
