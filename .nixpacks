# TengriChecker Railway Configuration

[nixpacks]
nixpkgs = ["nodejs-20_x"]

[variables]
NETWORK_PORT = "3001"
NETWORK_DATA = "/data"
NODE_ENV = "production"
PORT = "3001"

[start]
# Run server (node is in PATH from node:20-alpine image)
command = "node server.js"

[deploy]
healthCheckPath = "/api/health"
healthCheckInterval = 30
restartPolicyType = "ON_FAILURE"
restartPolicyMaxRetries = 10
