# TengriChecker Railway Configuration

[nixpacks]
nixpkgs = ["nodejs-20_x"]

[variables]
HONEY_POT_PORT = "3000"
HONEY_POT_DATA = "/data"
NODE_ENV = "production"

[start]
command = "node backend/api.js"

[deploy]
startCommand = "node backend/api.js"
healthCheckPath = "/health"
healthCheckInterval = 30
restartPolicyType = "ON_FAILURE"
restartPolicyMaxRetries = 10
